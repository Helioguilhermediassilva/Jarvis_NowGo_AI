# =============================================================================
# JARVIS / NOWGO AI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores antes de rodar
# `pnpm dev`. Nunca faça commit do .env.local.
# =============================================================================

# Chave da xAI (Grok). Necessária para chat, tool calling e sentiment.
# Obtenha em https://console.x.ai
XAI_API_KEY=

# Chave da ElevenLabs. Necessária para o TTS com a voz clonada do JARVIS.
# Obtenha em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# (Opcional) Gateway de LLM próprio. Quando omitido, o servidor chama
# a xAI diretamente com XAI_API_KEY.
LLM_API_URL=
LLM_API_KEY=

# =============================================================================
# Plataforma de Inteligência Soberana — Stripe Billing
# Configure estas variáveis apenas no ambiente do servidor. Nunca exponha a
# chave secreta no frontend nem faça commit de valores preenchidos.
# =============================================================================

# Origem pública usada nos success_url/cancel_url do Stripe Checkout.
NOWGO_PUBLIC_ORIGIN=https://www.nowgoai.com

# Chave secreta da conta Stripe NowGo AI, em live mode (sk_live_...).
NOWGO_BILLING_SECRET_KEY=

# Segredo de assinatura do endpoint de webhook criado no Stripe (whsec_...).
NOWGO_BILLING_WEBHOOK_SECRET=

# Price IDs do catálogo de produção.
NOWGO_BILLING_PRICE_SOVEREIGN_PRO_MONTHLY=
NOWGO_BILLING_PRICE_SOVEREIGN_BUSINESS_MONTHLY=
NOWGO_BILLING_PRICE_CREDITS_1000=
NOWGO_BILLING_PRICE_CREDITS_3000=
NOWGO_BILLING_PRICE_CREDITS_10000=
